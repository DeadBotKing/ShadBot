{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShadBot Agent Context Package",
  "description": "Contract schema for Project Intelligence output consumed by Agent Platform",
  "type": "object",

  "required": [
    "metadata",
    "project_id",
    "summary",
    "technologies",
    "frameworks",
    "languages",
    "dependencies"
  ],

  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "context_id",
        "version",
        "contract_version",
        "created_at"
      ],
      "properties": {
        "context_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "contract_version": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      }
    },

    "project_id": {
      "type": "string"
    },

    "summary": {
      "type": "string"
    },

    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "dependencies": {
      "type": "object"
    },

    "architecture_description": {
      "type": [
        "string",
        "null"
      ]
    },

    "conventions": {
      "type": "array"
    },

    "constraints": {
      "type": "array"
    },

    "recommendations": {
      "type": "array"
    },

    "current_state": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "evolution": {
    "type": [
      "object",
      "null"
    ],
    "properties": {
      "recent_changes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "added_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "removed_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "modified_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "impact_summary": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}